{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soplos-welcome-live",
  "version": "3.0.0-beta",
  "identifier": "org.soplos.welcomelive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soplos Welcome Live",
        "width": 1000,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "Sergi Perich",
    "homepage": "https://soplos.org",
    "copyright": "Copyright © 2026 Sergi Perich",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Welcome screen for Soplos Linux live sessions",
    "longDescription": "The welcome screen of the Soplos Linux live session. Install Soplos Linux, repair an installed system, partition disks, and change the language and keyboard of the live session.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "sudo",
          "pkexec | policykit-1",
          "util-linux",
          "locales",
          "x11-xkb-utils",
          "xdg-user-dirs"
        ],
        "recommends": [
          "gparted",
          "calamares",
          "numlockx"
        ],
        "changelog": "../CHANGELOG.md",
        "desktopTemplate": "resources/debian/soplos-welcome-live.desktop.hbs",
        "files": {
          "/usr/share/soplos-welcome-live/installer.json": "resources/installer/installer.json",
          "/usr/share/metainfo/org.soplos.welcomelive.metainfo.xml": "resources/appstream/org.soplos.welcomelive.metainfo.xml",
          "/usr/share/doc/soplos-welcome-live/copyright": "resources/debian/copyright",
          "/usr/share/doc/soplos-welcome-live/screenshots/screenshot01.png": "resources/screenshots/screenshot01.png",
          "/usr/share/doc/soplos-welcome-live/screenshots/screenshot02.png": "resources/screenshots/screenshot02.png",
          "/usr/share/doc/soplos-welcome-live/screenshots/screenshot03.png": "resources/screenshots/screenshot03.png",
          "/usr/share/doc/soplos-welcome-live/screenshots/screenshot04.png": "resources/screenshots/screenshot04.png",
          "/usr/share/doc/soplos-welcome-live/screenshots/screenshot05.png": "resources/screenshots/screenshot05.png",
          "/usr/share/doc/soplos-welcome-live/screenshots/screenshot06.png": "resources/screenshots/screenshot06.png",
          "/usr/share/man/man1/soplos-welcome-live.1.gz": "resources/docs/soplos-welcome-live.1.gz"
        }
      }
    }
  }
}
